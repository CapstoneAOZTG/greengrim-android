<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.aoztg.greengrim.presentation.ui.global.nftdetail.NftDetailViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/padding_middle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_scrollFlags="scroll|enterAlways">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:onClick="@{() -> vm.navigateToBack()}"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header"
                style="@style/TextHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="NFT 상세보기"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{() -> vm.nftLike()}"
                android:src="@{vm.uiState.nftDetail.liked ? @drawable/icon_nft_detail_heart : @drawable/icon_nft_detail_empty_heart}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_more"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:onClick="@{() -> vm.showPopUp()}"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_more"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="200dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_nft"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="centerCrop"
                    app:imgUrl="@{vm.uiState.nftDetail.nftImage}"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/All28RadiusImageView"
                    tools:src="@drawable/test" />

                <TextView
                    android:id="@+id/tv_title"
                    style="@style/TextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@{vm.uiState.nftDetail.title}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_nft"
                    tools:text="떠도는 풀쑾" />

                <TextView
                    android:id="@+id/tv_description"
                    style="@style/TextGgSmallGrey1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@{vm.uiState.nftDetail.description}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    tools:text="이 NFT는 제가 춘식이를 좋아하는 마음을 담아 만들었답니다. 춘식이는 라이언이 냥줍해서 같이 살게 된 고양이인데요 코 옆에 주름이 너무 하찮아서 최애 캐릭터에요." />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_profile_img"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{() -> vm.navigateToProfile()}"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_description"
                    app:profileImgUrl="@{vm.uiState.nftDetail.profileImage}"
                    tools:src="@drawable/test" />

                <TextView
                    android:id="@+id/tv_nickName"
                    style="@style/TextGgSmallGrey1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToProfile()}"
                    android:layout_marginStart="12dp"
                    android:text="@{vm.uiState.nftDetail.nickName}"
                    android:textSize="14dp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_profile_img"
                    app:layout_constraintStart_toEndOf="@id/iv_profile_img"
                    app:layout_constraintTop_toTopOf="@id/iv_profile_img"
                    tools:text="지구를지켜보라" />

                <TextView
                    android:id="@+id/tv_date"
                    style="@style/TextGgSmallGrey5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{vm.uiState.nftDetail.date}"
                    app:layout_constraintBottom_toBottomOf="@id/iv_profile_img"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/iv_profile_img"
                    tools:text="2023년 8월 17일" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divdier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:dividerColor="@color/gg_grey1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_profile_img" />

                <TextView
                    android:id="@+id/tv_detail_label"
                    style="@style/TextGgMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="상세 정보"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divdier" />

                <LinearLayout
                    android:id="@+id/block_background"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toStartOf="@id/block_hair"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_detail_label">

                    <TextView
                        android:id="@+id/tv_background_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BACKGROUND"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_background"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.background}"
                        tools:text="black" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_hair"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toStartOf="@id/block_face"
                    app:layout_constraintStart_toEndOf="@id/block_background"
                    app:layout_constraintTop_toTopOf="@id/block_background">


                    <TextView
                        android:id="@+id/tv_hair_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HAIR"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hair"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.hair}"
                        tools:text="mandra" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_face"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/block_hair"
                    app:layout_constraintTop_toTopOf="@id/block_background">

                    <TextView
                        android:id="@+id/tv_face_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FACE"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_face"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.face}"
                        tools:text="basic" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_gesture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toStartOf="@id/block_accessory"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/block_background">

                    <TextView
                        android:id="@+id/tv_gesture_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GESTURE"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_gesture"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.gesture}"
                        tools:text="peace" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_accessory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toStartOf="@id/block_shoes"
                    app:layout_constraintStart_toEndOf="@id/block_gesture"
                    app:layout_constraintTop_toTopOf="@id/block_gesture">

                    <TextView
                        android:id="@+id/tv_accessory_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCESSORY"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_accessory"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.accessory}"
                        tools:text="headphone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_shoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/block_accessory"
                    app:layout_constraintTop_toTopOf="@id/block_gesture">

                    <TextView
                        android:id="@+id/tv_shoes_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHOES"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_shoes"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.shoes}"
                        tools:text="blue" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_rarity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_black4fill_nostroke_radius10"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toEndOf="@id/block_gesture"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/block_gesture">

                    <TextView
                        android:id="@+id/tv_rarity_label"
                        style="@style/TextGgSmallGrey5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RARITY"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_rarity"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@{vm.uiState.nftDetail.rarity}"
                        tools:text="blue" />

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/heart_anim"
            android:layout_width="250dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_fileName="heart.json"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>