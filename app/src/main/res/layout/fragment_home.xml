<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.aoztg.greengrim.presentation.ui.home.HomeViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/layout_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_large"
                android:paddingVertical="@dimen/padding_middle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_scrollFlags="scroll|enterAlways">

                <TextView
                    android:id="@+id/tv_header"
                    style="@style/TextHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_alarm"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btn_alarm"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_alarm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="200dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_constraintTop_toBottomOf="@id/layout_appbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/padding_large">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_user_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/shape_black2fill_nostroke_radius20"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    app:layout_constraintEnd_toStartOf="@id/layout_welcome_nft"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/TextGgMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@{vm.uiState.nickName}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="올때메로나유보라" />

                    <TextView
                        android:id="@+id/tv_name_label"
                        style="@style/TextGgSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="님의"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/tv_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_name" />

                    <TextView
                        android:id="@+id/tv_carbon_down_label"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="탄소 저감량"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_name" />

                    <ImageView
                        android:id="@+id/iv_carbon_down_info"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/icon_info"
                        app:layout_constraintBottom_toBottomOf="@id/tv_carbon_down_label"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/tv_carbon_down_label"
                        app:layout_constraintTop_toTopOf="@id/tv_carbon_down_label" />

                    <TextView
                        android:id="@+id/tv_carbon_down"
                        style="@style/TextHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@{vm.uiState.carbonReduction}"
                        android:textAlignment="textEnd"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_carbon_down_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_carbon_down_info"
                        app:layout_constraintTop_toTopOf="@id/tv_carbon_down_label"
                        tools:text="165.0 g" />

                    <TextView
                        android:id="@+id/tv_green_point_label"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="그린 포인트"
                        app:layout_constraintBottom_toBottomOf="@id/tv_green_point"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_green_point" />

                    <ImageView
                        android:id="@+id/iv_green_point_info"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/icon_info"
                        app:layout_constraintBottom_toBottomOf="@id/tv_green_point_label"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/tv_green_point_label"
                        app:layout_constraintTop_toTopOf="@id/tv_green_point_label" />

                    <TextView
                        android:id="@+id/tv_green_point"
                        style="@style/TextHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@{vm.uiState.greenPoint}"
                        android:textAlignment="textEnd"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_green_point_info"
                        app:layout_constraintTop_toBottomOf="@id/tv_carbon_down"
                        tools:text="1,730 GP" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_welcome_nft"
                    android:layout_width="130dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_black3fill_nostroke_radius20"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    app:layout_constraintBottom_toBottomOf="@id/layout_user_info"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/layout_user_info">

                    <TextView
                        android:id="@+id/tv_welcome_message"
                        style="@style/TextGgSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@{vm.uiState.eventName}"
                        app:layout_constraintBottom_toTopOf="@id/iv_present"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_present"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:imgUrl="@{vm.uiState.eventImg}"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_label_hot_challenge"
                    style="@style/TextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/hot_challenge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_user_info" />

                <TextView
                    android:id="@+id/tv_detail_hot_challenge"
                    style="@style/TextGgSmallGrey1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="지금 핫한 챌린지"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_hot_challenge" />

                <ImageButton
                    android:id="@+id/btn_see_more_challenge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:onClick="@{() -> vm.navigateToHotChallengeList()}"
                    android:src="@drawable/icon_see_more"
                    app:layout_constraintBottom_toBottomOf="@id/tv_detail_hot_challenge"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot_challenge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_detail_hot_challenge" />

                <me.relex.circleindicator.CircleIndicator2
                    android:id="@+id/indicator_hot_challenge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    app:ci_animator="@anim/alpha"
                    app:ci_drawable="@drawable/shape_indicator_select"
                    app:ci_drawable_unselected="@drawable/shape_indicator_unselect"
                    app:ci_height="8dp"
                    app:ci_width="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_hot_challenge" />

                <TextView
                    android:id="@+id/tv_label_hot_nft"
                    style="@style/TextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/hot_nft"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/indicator_hot_challenge" />

                <TextView
                    android:id="@+id/tv_detail_hot_nft"
                    style="@style/TextGgSmallGrey1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="지금 핫한 NFT"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_hot_nft" />

                <ImageButton
                    android:id="@+id/btn_see_more_nft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:onClick="@{() -> vm.navigateToNftList()}"
                    android:src="@drawable/icon_see_more"
                    app:layout_constraintBottom_toBottomOf="@id/tv_detail_hot_nft"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot_nft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_detail_hot_nft" />

                <me.relex.circleindicator.CircleIndicator2
                    android:id="@+id/indicator_hot_nft"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    app:ci_animator="@anim/alpha"
                    app:ci_drawable="@drawable/shape_indicator_select"
                    app:ci_drawable_unselected="@drawable/shape_indicator_unselect"
                    app:ci_height="8dp"
                    app:ci_width="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_hot_nft" />

                <TextView
                    android:id="@+id/tv_label_more_activity"
                    style="@style/TextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/recent_issues"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/indicator_hot_nft" />

                <TextView
                    android:id="@+id/tv_detail_recent_issue"
                    style="@style/TextGgSmallGrey1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="최신 환경 이슈"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_more_activity" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_issues"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_detail_recent_issue" />

                <me.relex.circleindicator.CircleIndicator2
                    android:id="@+id/indicator_recent_issue"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    app:ci_animator="@anim/alpha"
                    app:ci_drawable="@drawable/shape_indicator_select"
                    app:ci_drawable_unselected="@drawable/shape_indicator_unselect"
                    app:ci_height="8dp"
                    app:ci_width="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_recent_issues" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>