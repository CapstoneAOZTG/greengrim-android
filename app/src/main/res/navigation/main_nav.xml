<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/home_fragment">

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_fragment_to_hotChallengeListFragment"
            app:destination="@id/hotChallengeListFragment" />
    </fragment>

    <fragment
        android:id="@+id/challenge_category_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.challenge.category.ChallengeCategoryFragment"
        android:label="Challenge"
        tools:layout="@layout/fragment_challenge_category">
        <action
            android:id="@+id/action_challenge_category_fragment_to_create_challenge_fragment"
            app:destination="@id/create_challenge_fragment" />
        <action
            android:id="@+id/action_challenge_category_fragment_to_challenge_list_fragment"
            app:destination="@id/challenge_list_fragment" />
        <action
            android:id="@+id/action_challenge_category_fragment_to_searchChallengeFragment"
            app:destination="@id/searchChallengeFragment" />
    </fragment>

    <fragment
        android:id="@+id/challenge_list_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.challenge.list.ChallengeListFragment"
        android:label="ChallengeList"
        tools:layout="@layout/fragment_challenge_list">
        <argument
            android:name="categoryText"
            app:argType="string" />
        <argument
            android:name="categoryValue"
            app:argType="string" />
        <action
            android:id="@+id/action_challenge_list_fragment_to_create_challenge_fragment"
            app:destination="@id/create_challenge_fragment" />
        <action
            android:id="@+id/action_challenge_list_fragment_to_searchChallengeFragment"
            app:destination="@id/searchChallengeFragment" />
    </fragment>

    <fragment
        android:id="@+id/create_challenge_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.challenge.create.CreateChallengeFragment"
        android:label="CreateChallenget"
        tools:layout="@layout/fragment_create_challenge">
        <action
            android:id="@+id/action_create_challenge_fragment_to_create_challenge_detail_fragment"
            app:destination="@id/create_challenge_detail_fragment" />
    </fragment>

    <fragment
        android:id="@+id/create_challenge_detail_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.challenge.create.CreateChallengeDetailFragment"
        android:label="CreateChallengeDetail"
        tools:layout="@layout/fragment_create_challenge_detail">
        <argument
            android:name="categoryText"
            app:argType="string" />

        <argument
            android:name="categoryValue"
            app:argType="string" />
        <action
            android:id="@+id/action_create_challenge_detail_fragment_to_chat_list_fragment"
            app:destination="@id/chat_list_fragment"
            app:popUpTo="@id/challenge_category_fragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/challenge_detail_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.challengedetail.ChallengeDetailFragment"
        android:label="ChallengeDetail"
        tools:layout="@layout/fragment_challenge_detail">
        <argument
            android:name="challengeId"
            app:argType="long" />
        <action
            android:id="@+id/action_challenge_detail_fragment_to_chat_room_fragment"
            app:destination="@id/chat_room_fragment" />
    </fragment>

    <fragment
        android:id="@+id/chat_list_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.chat.chatlist.ChatListFragment"
        android:label="ChatList"
        tools:layout="@layout/fragment_chat_list">
        <action
            android:id="@+id/action_chat_list_fragment_to_chat_room_fragment"
            app:destination="@id/chat_room_fragment" />
    </fragment>

    <fragment
        android:id="@+id/chat_room_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.chat.chatroom.ChatRoomFragment"
        android:label="ChatRoom"
        tools:layout="@layout/fragment_chat_room">
        <argument
            android:name="chatName"
            android:defaultValue="채팅방"
            app:argType="string" />
        <argument
            android:name="chatId"
            app:argType="long" />
        <argument
            android:name="challengeId"
            app:argType="long" />
        <action
            android:id="@+id/action_chat_room_fragment_to_make_certification_fragment"
            app:destination="@id/create_certification_fragment" />
        <action
            android:id="@+id/action_chat_room_fragment_to_create_certification_fragment"
            app:destination="@id/create_certification_fragment" />
        <action
            android:id="@+id/action_chat_room_fragment_to_certificationListBottomSheetFragment"
            app:destination="@id/certificationListBottomSheetFragment" />
    </fragment>

    <dialog
        android:id="@+id/certificationListBottomSheetFragment"
        android:name="com.aoztg.greengrim.presentation.ui.chat.certificationlist.CertificationListBottomSheetFragment"
        android:label="CertificationListBottomSheetFragment" >

        <argument
            android:name="challengeId"
            app:argType="long"/>

    </dialog>



    <fragment
        android:id="@+id/create_certification_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.chat.createcertification.CreateCertificationFragment"
        android:label="CreateCertification"
        tools:layout="@layout/fragment_create_certification">
        <argument
            android:name="challengeId"
            app:argType="long" />
        <argument
            android:name="chatId"
            app:argType="long" />
        <argument
            android:name="certificationCount"
            app:argType="integer" />
        <argument
            android:name="challengeName"
            app:argType="string" />
        <argument
            android:name="categoryName"
            app:argType="string" />
        <argument
            android:name="ticketCount"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/certification_detail_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.certificationdetail.CertificationDetailFragment"
        android:label="CertificationDetail"
        tools:layout="@layout/fragment_certification_detail">
        <argument
            android:name="certificationId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nft_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.nft.NftFragment"
        android:label="Nft"
        tools:layout="@layout/fragment_nft">
        <action
            android:id="@+id/action_nft_fragment_to_nftCollectionFragment"
            app:destination="@id/nftCollectionFragment" />
        <action
            android:id="@+id/action_nft_fragment_to_exchangeNftFragment"
            app:destination="@id/exchangeNftFragment" />
        <action
            android:id="@+id/action_nft_fragment_to_addWalletFragment"
            app:destination="@id/addWalletFragment" />
    </fragment>

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.MyPageFragment"
        android:label="Info"
        tools:layout="@layout/fragment_mypage">
        <action
            android:id="@+id/action_myPageFragment_to_myPointFragment"
            app:destination="@id/myPointFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_myProfileFragment"
            app:destination="@id/myProfileFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_mySettingFragment"
            app:destination="@id/mySettingFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_addWalletFragment"
            app:destination="@id/addWalletFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_editWalletFragment"
            app:destination="@id/editWalletFragment" />
    </fragment>

    <fragment
        android:id="@+id/edit_profile_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.editprofile.EditProfileFragment"
        android:label="EditProfile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/attend_check_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.attendcheck.AttendCheckFragment"
        android:label="AttendCheck"
        tools:layout="@layout/fragment_attend_check" />

    <fragment
        android:id="@+id/nft_detail_fragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.nftdetail.NftDetailFragment"
        android:label="NftDetail"
        tools:layout="@layout/fragment_nft_detail">

        <argument
            android:name="nftId"
            app:argType="long" />

    </fragment>

    <fragment
        android:id="@+id/nftCollectionFragment"
        android:name="com.aoztg.greengrim.presentation.ui.nft.nftcollection.NftCollectionFragment"
        android:label="NftList"
        tools:layout="@layout/fragment_nft_collection">

        <argument
            android:name="selectRarity"
            app:argType="string"/>

        <argument
            android:name="basicCount"
            app:argType="integer" />

        <argument
            android:name="standardCount"
            app:argType="integer" />

        <argument
            android:name="premiumCount"
            app:argType="integer" />

        <action
            android:id="@+id/action_nftCollectionFragment_to_exchangeNftFragment"
            app:destination="@id/exchangeNftFragment" />
    </fragment>

    <fragment
        android:id="@+id/exchangeNftFragment"
        android:name="com.aoztg.greengrim.presentation.ui.nft.exchange.ExchangeNftFragment"
        tools:layout="@layout/fragment_exchange_nft">
        <action
            android:id="@+id/action_exchangeNftFragment_to_exchangeNftDetailFragment"
            app:destination="@id/exchangeNftDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exchangeNftDetailFragment"
        android:name="com.aoztg.greengrim.presentation.ui.nft.exchange.detail.ExchangeNftDetailFragment"
        tools:layout="@layout/fragment_exchange_nft_detail">
        <argument
            android:name="grade"
            app:argType="string" />

        <action
            android:id="@+id/action_exchangeNftDetailFragment_to_editExchangedNftFragment"
            app:destination="@id/editExchangedNftFragment"
            app:popUpTo="@id/exchangeNftFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/editExchangedNftFragment"
        android:name="com.aoztg.greengrim.presentation.ui.nft.exchange.edit.EditExchangedNftFragment"
        android:label="EditCreatedNftFragment"
        tools:layout="@layout/fragment_edit_exchanged_nft">

        <argument
            android:name="imgUrl"
            app:argType="string" />

        <argument
            android:name="nftId"
            app:argType="long" />
        <action
            android:id="@+id/action_editExchangedNftFragment_to_nft_detail_fragment"
            app:destination="@id/nft_detail_fragment"
            app:popUpTo="@id/nft_fragment"
            app:popUpToInclusive="false" />

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.profile.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">

        <argument
            android:name="id"
            app:argType="long" />

    </fragment>

    <fragment
        android:id="@+id/myProfileFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.myprofile.MyProfileFragment"
        android:label="MyProfileFragment"
        tools:layout="@layout/fragment_my_profile">
        <action
            android:id="@+id/action_myProfileFragment_to_edit_profile_fragment"
            app:destination="@id/edit_profile_fragment" />
        <action
            android:id="@+id/action_myProfileFragment_to_chat_list_fragment"
            app:destination="@id/chat_list_fragment" />
        <action
            android:id="@+id/action_myProfileFragment_to_nft_fragment"
            app:destination="@id/nft_fragment" />
    </fragment>

    <fragment
        android:id="@+id/myPointFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.mypoint.MyPointFragment"
        android:label="MyPointFragment"
        tools:layout="@layout/fragment_my_point">

        <argument
            android:name="name"
            android:defaultValue=""
            app:argType="string" />

        <argument
            android:name="totalPoint"
            android:defaultValue=""
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/addWalletFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.mywallet.AddWalletFragment"
        android:label="AddWalletFragment"
        tools:layout="@layout/fragment_add_wallet">
        <action
            android:id="@+id/action_addWalletFragment_to_addWalletDetailFragment"
            app:destination="@id/addWalletDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/hotChallengeListFragment"
        android:name="com.aoztg.greengrim.presentation.ui.home.HotChallengeListFragment"
        android:label="HotChallengeListFragment"
        tools:layout="@layout/fragment_hot_challenge_list" />

    <fragment
        android:id="@+id/searchChallengeFragment"
        android:name="com.aoztg.greengrim.presentation.ui.challenge.search.SearchChallengeFragment"
        android:label="SearchChallengeFragment"
        tools:layout="@layout/fragment_search_challenge">

        <argument
            android:name="category"
            android:defaultValue=""
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/webViewFragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.webview.WebViewFragment"
        android:label="WebViewFragment">

        <argument
            android:name="url"
            android:defaultValue=""
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/mySettingFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.MySettingFragment"
        android:label="MySettingFragment"
        tools:layout="@layout/fragment_my_setting">

        <argument
            android:name="hasWallet"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_mySettingFragment_to_edit_profile_fragment"
            app:destination="@id/edit_profile_fragment" />
        <action
            android:id="@+id/action_mySettingFragment_to_addWalletFragment"
            app:destination="@id/addWalletFragment" />
        <action
            android:id="@+id/action_mySettingFragment_to_editWalletFragment"
            app:destination="@id/editWalletFragment" />
        <action
            android:id="@+id/action_mySettingFragment_to_editAlarmFragment"
            app:destination="@id/editAlarmFragment" />
    </fragment>

    <fragment
        android:id="@+id/editWalletFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.mywallet.EditWalletFragment"
        android:label="EditWalletFragment"
        tools:layout="@layout/fragment_edit_wallet">
        <action
            android:id="@+id/action_editWalletFragment_to_myPageFragment"
            app:destination="@id/myPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/addWalletDetailFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.mywallet.AddWalletDetailFragment"
        android:label="AddWalletDetailFragment"
        tools:layout="@layout/fragment_add_wallet_detail">
        <action
            android:id="@+id/action_addWalletDetailFragment_to_myPageFragment"
            app:destination="@id/myPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/editAlarmFragment"
        android:name="com.aoztg.greengrim.presentation.ui.mypage.alarm.EditAlarmFragment"
        android:label="EditAlarmFragment"
        tools:layout="@layout/fragment_edit_alarm" />

    <fragment
        android:id="@+id/alarmCheckFragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.alarm.AlarmCheckFragment"
        android:label="AlarmCheckFragment" />

    <fragment
        android:id="@+id/nftCollectionDetailFragment"
        android:name="com.aoztg.greengrim.presentation.ui.global.nftdetail.NftCollectionDetailFragment"
        android:label="NftCollectionDetailFragment" >

        <argument
            android:name="id"
            app:argType="long"/>

    </fragment>

    <action
        android:id="@+id/action_global_to_attendCheckFragment"
        app:destination="@id/attend_check_fragment" />

    <action
        android:id="@+id/action_global_to_challengeDetailFragment"
        app:destination="@id/challenge_detail_fragment" />

    <action
        android:id="@+id/action_global_to_certificationDetail"
        app:destination="@id/certification_detail_fragment" />

    <action
        android:id="@+id/action_global_to_nftDetailFragment"
        app:destination="@id/nft_detail_fragment" />

    <action
        android:id="@+id/action_global_to_profileFragment"
        app:destination="@id/profileFragment" />

    <action
        android:id="@+id/action_global_to_webviewFragment"
        app:destination="@id/webViewFragment" />

    <action
        android:id="@+id/action_global_to_challengeCategoryFragment"
        app:destination="@id/challenge_category_fragment" />

    <action
        android:id="@+id/action_global_to_alarmCheckFragment"
        app:destination="@id/alarmCheckFragment"/>

    <action
        android:id="@+id/action_global_to_nftCollectionDetailFragment"
        app:destination="@id/nftCollectionDetailFragment"/>

</navigation>